' =====================================================================
' 10. ACTIVITY DIAGRAM - SCHEDULER EDF/EDD
' =====================================================================

@startuml
title Activity Scheduler EDF/EDD - Aqiqah System

|Sistem|
start
:Scheduler dipanggil:
- Setelah create order (auto)
- Klik "Run Scheduler" (manual);

|Database|
:SELECT * FROM orders
WHERE status = 'Pending';

|Sistem|
if (Data ditemukan?) then (Tidak)
  :Set flash "0 pesanan dijadwalkan";
  stop
endif

:Mengurutkan data
berdasarkan slaughter_date ASC
(Earliest Deadline First);

|Database|
:TRUNCATE TABLE schedules
(hapus jadwal lama);

|Sistem|
:Inisialisasi priority = 1;

while (Ada data Pending)
  |Sistem|
  :Siapkan data schedule:
  - order_id
  - slaughter_date
  - priority = $i;
  |Database|
  :INSERT INTO schedules;
  |Sistem|
  :UPDATE orders
  SET status = 'Scheduled';
  :priority++;
endwhile

|Sistem|
:Flash success
"X pesanan dijadwalkan";

:Redirect ke dashboard;
stop
@enduml



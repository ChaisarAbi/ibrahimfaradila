' =====================================================================
' 1. ERD (ENTITY RELATIONSHIP DIAGRAM)
' =====================================================================

@startuml
' Hide the spot
hide circle
' Avoid problems with angled crows feet
skinparam linetype ortho
skinparam packageStyle rectangle

title Entity Relationship Diagram\nIbrahim Aqiqah - Sistem Manajemen Penjadwalan & Notifikasi

' ====== ENTITY DEFINITIONS ======

entity "users" as users {
  * id_user : INT <<PK>>
  --
  * username : VARCHAR(50) <<UNIQUE>>
  * password : VARCHAR(255)
  * fullname : VARCHAR(100)
  * role : ENUM('admin','rph','dapur')
  * created_at : DATETIME
}

entity "packages" as packages {
  * id_package : INT <<PK>>
  --
  * name : VARCHAR(50)
  * weight_type : CHAR(1)
  * min_weight : DECIMAL(5,2)
  * max_weight : DECIMAL(5,2)
  * box_count : INT
  * price : DECIMAL(12,2)
  * is_special : BOOLEAN
}

entity "bone_menus" as bone_menus {
  * id_bone : INT <<PK>>
  --
  * name : VARCHAR(50) <<UNIQUE>>
}

entity "meat_menus" as meat_menus {
  * id_meat : INT <<PK>>
  --
  * name : VARCHAR(50) <<UNIQUE>>
}

entity "customers" as customers {
  * id_customer : INT <<PK>>
  --
  * name : VARCHAR(100)
  * child_name : VARCHAR(100)
  * gender : ENUM('Laki-laki','Perempuan')
  * birth_date : DATE
  * phone : VARCHAR(15)
  * address : TEXT
  * created_at : DATETIME
}

entity "orders" as orders {
  * id_order : INT <<PK>>
  --
  * customer_id : INT <<FK>>
  * package_id : INT <<FK>>
  * animal_type : ENUM('Domba','Kambing')
  * animal_gender : ENUM('Jantan','Betina')
  * jumlah_anak : INT
  * slaughter_date : DATE
  * delivery_date : DATE
  * slaughter_time : TIME
  * penyembelihan : ENUM('Dokumentasi','Video Call','Visit')
  * use_photo_card : BOOLEAN
  * use_photo_certificate : BOOLEAN
  * photo_path : VARCHAR(255) <<NULL>>
  * status : ENUM('Pending','Scheduled','Processing','Completed','Cancelled')
  * total_price : DECIMAL(12,2)
  * created_at : DATETIME
}

entity "order_details" as order_details {
  * id_detail : INT <<PK>>
  --
  * order_id : INT <<FK>>
  * bone_menu_id : INT <<FK>> <<NULL>>
  * meat_menu_id : INT <<FK>> <<NULL>>
  * box_type : ENUM('Box Premium','Bento Pack')
  * jumlah_box : INT
}

entity "schedules" as schedules {
  * id_schedule : INT <<PK>>
  --
  * order_id : INT <<FK>>
  * slaughter_date : DATE
  * priority : INT
  * status : ENUM('Scheduled','In Progress','Done')
}

entity "notifications" as notifications {
  * id_notif : INT <<PK>>
  --
  * order_id : INT <<FK>> <<NULL>>
  * type : ENUM('24h_reminder','stock_alert','order_confirmation','daily_recap')
  * message : TEXT
  * sent_at : DATETIME
  * is_read : BOOLEAN
}

entity "stocks" as stocks {
  * id_stock : INT <<PK>>
  --
  * item_name : VARCHAR(100)
  * category : ENUM('hewan','bahan')
  * quantity : INT
  * min_threshold : INT
  * unit : VARCHAR(20)
  * updated_at : DATETIME
}

entity "telegram_recipients" as telegram_recipients {
  * id_recipient : INT <<PK>>
  --
  * chat_id : VARCHAR(100)
  * name : VARCHAR(255)
  * type : ENUM('personal','group')
  * created_at : DATETIME
}

entity "settings" as settings {
  * id_setting : INT <<PK>>
  --
  * setting_key : VARCHAR(50) <<UNIQUE>>
  * setting_value : TEXT
}


' ====== RELATIONSHIPS ======

' orders -> customers
customers ||--o{ orders : "1:N\nmemiliki"

' orders -> packages
packages ||--o{ orders : "1:N\ndipesan"

' orders -> order_details
orders ||--o{ order_details : "1:N\nberisi"

' order_details -> bone_menus
bone_menus ||--o{ order_details : "1:N\ndigunakan"

' order_details -> meat_menus
meat_menus ||--o{ order_details : "1:N\ndigunakan"

' orders -> schedules
orders ||--o{ schedules : "1:N\ndijadwalkan"

' orders -> notifications
orders ||--o{ notifications : "0..1:N\ndilog"

@enduml


' =====================================================================
' 2. ACTIVITY DIAGRAM - AUTH (LOGIN)
' =====================================================================

@startuml
title Activity Login - Aqiqah System

|Admin|
start
:Membuka halaman login;
:Memasukkan username & password;
:Mengklik tombol Login;

|Sistem|
:Menerima request POST /login;
:Mencari user di database;

|Database|
:Query SELECT * FROM users
WHERE username = ?;

|Sistem|
if (Username ditemukan?) then (Tidak)
  :Set flashdata error
  "Username tidak ditemukan";
  |Admin|
  :Melihat pesan error;
  stop
else (Ya)
  :Mengambil hashed password
  dari database;
  :Verifikasi password
  dengan password_verify();
endif

if (Password cocok?) then (Tidak)
  :Set flashdata error
  "Password salah";
  |Admin|
  :Melihat pesan error;
  stop
else (Ya)
  :Membuat session:
  - id_user
  - username
  - fullname
  - role
  - isLoggedIn = TRUE;
  |Database|
  :Menyimpan session di server;
  |Sistem|
  :Redirect ke /admin/dashboard;
  |Admin|
  :Melihat halaman Dashboard;
  stop
endif
@enduml


' =====================================================================
' 3. ACTIVITY DIAGRAM - LOGOUT

' =====================================================================
' 25. ACTIVITY DIAGRAM - RPH JALANKAN SCHEDULER EDF
' =====================================================================

@startuml
title Activity Jalankan Scheduler EDF oleh RPH - Aqiqah System

|User RPH|
start
:Membuka sidebar;
:Melihat menu "Jadwalkan (EDF)";
:Mengklik link tersebut;

|Sistem|
:GET /admin/scheduler/run;
:RphFilter: cek session role;
if (role == admin/rph?) then (Ya)
  :Lanjutkan;
else (Tidak)
  :Redirect ke /admin/stock
  + flash error;
  stop
endif

|Database|
:SELECT * FROM orders
WHERE status = 'Pending'
ORDER BY slaughter_date ASC;

|Sistem|
if (Ada data Pending?) then (Ya)
  :Hapus semua schedule
  yang sudah ada;

  |Database|
  :TRUNCATE TABLE schedules;

  |Sistem|
  :priority = 1;
  while (foreach order Pending)
    |Database|
    :INSERT INTO schedules
    (order_id, slaughter_date,
     priority, status);
    |Sistem|
    :UPDATE orders
    SET status = 'Scheduled'
    WHERE id_order = ?;
    :priority++;
  endwhile

  :Flash success:
  "X pesanan berhasil dijadwalkan";
else (Tidak ada)
  :Flash:
  "0 pesanan berhasil dijadwalkan";
endif

:Redirect ke /admin/stock;
|User RPH|
:Melihat pesan flash
di halaman stok;
stop
@enduml



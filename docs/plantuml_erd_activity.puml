' =====================================================================
' 13. ACTIVITY DIAGRAM - CALENDAR EVENTS
' =====================================================================

@startuml
title Activity Calendar - Aqiqah System

|Admin|
start
:Membuka halaman Kalender;

|Sistem|
:FullCalendar.js inisialisasi;
:JavaScript memanggil
GET /admin/calendar/events;

|Database|
:SELECT schedules
JOIN orders, customers;

|Sistem|
if (Schedules ditemukan?) then (Ya)
  foreach (schedule)
    :Tentukan warna priority:
    P1 -> Merah
    P2 -> Kuning
    P3+ -> Hijau;
    :Buat event object:
    - id, title, start
    - color, textColor
    - url = edit order;
  endforeach
else (Fallback)
  |Database|
  :SELECT orders
  WHERE status != 'Cancelled';
  |Sistem|
  foreach (order)
    :Tentukan warna status:
    Pending -> Orange
    Scheduled -> Blue
    Processing -> Yellow
    Completed -> Green
    Cancelled -> Grey;
    :Buat event object;
  endforeach
endif

:Sending JSON ke frontend;
|Admin|
:FullCalendar.js render events;
:Melihat kalender dengan
warna dan link ke edit order;
stop
@enduml



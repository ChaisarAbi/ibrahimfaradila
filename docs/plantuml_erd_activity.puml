' =====================================================================
' 18. ACTIVITY DIAGRAM - NOTIFICATIONS TODAY RECAP
' =====================================================================

@startuml
title Activity Kirim Rekap Harian - Telegram

|Admin|
start
:Membuka menu Notifikasi;
:Mengklik "Kirim Rekap Hari Ini";

|Sistem|
:GET /admin/notifications/send-today-recap;
:Mengambil orders hari ini;

|Database|
:SELECT orders
WHERE slaughter_date = TODAY
AND status != 'Cancelled';

|Sistem|
if (Ada orders?) then (Ya)
  :Hitung total_box, domba, kambing;
  :Hitung rekap dapur
  (akumulasi menu per nama);
  :Hitung pengantaran hari ini;
  :Susun pesan Markdown:
  - Ringkasan operasional
  - Daftar pesanan + menu
  - Rekap dapur
  - Status stok;
else (Kosong)
  |Database|
  :SELECT * FROM stocks;
  |Sistem|
  :Tandai item menipis
  (qty <= min_threshold);
  :Susun pesan:
  "Tidak ada jadwal hari ini"
  + status stok;
endif

|Sistem|
:Ambil recipients dari database;

|Database|
:SELECT * FROM telegram_recipients;

|Sistem|
foreach (recipient)
  :Kirim pesan via TelegramBot;
  |Telegram Bot|
  :sendMessage(chat_id, message);
  |Telegram API|
  :Meneruskan pesan ke user;
  |Telegram Bot|
  :Return response;
endforeach

|Sistem|
:Simpan log ke tabel notifications;

|Database|
:INSERT INTO notifications
(type='daily_recap', message);

|Sistem|
:Set flash success;
|Admin|
:Redirect ke dashboard
+ melihat flash message;
stop
@enduml


' =====================================================================
' 19. ACTIVITY DIAGRAM - NOTIFICATIONS H+1 FOLLOW-UP
' =====================================================================

@startuml
title Activity Kirim Follow-up H+1 - Telegram

|Admin|
start
:Menu Notifikasi;
:Mengklik "Kirim Follow-up H+1";

|Sistem|
:GET /admin/notifications/send-h-plus-1;
:Mengambil orders kemarin;

|Database|
:SELECT orders
WHERE slaughter_date = YESTERDAY
AND status != 'Cancelled';

|Sistem|
foreach (order)
  :Ambil customer, package, details;
  :Hitung total_box & menu;
  :Cek jika delivery == TODAY;
  :Buat pesan per order:
  "FOLLOW-UP H+1"
  + detail order
  + status terkini
  + info pengantaran;

  |Telegram Bot|
  :sendMessage ke semua recipients;

  |Database|
  :INSERT INTO notifications
